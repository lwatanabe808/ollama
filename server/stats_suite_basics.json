{
  "name": "basics",
  "title": "Basics",
  "description": "Standard scenarios for comparing models on your machine. Performance scenarios change one thing at a time. Fact checks grade answers separately.",
  "performance": [
    {
      "id": "cold-start",
      "title": "Cold start",
      "group": "Loading",
      "isolates": "Loading the model from disk",
      "cold": true,
      "input": "tiny",
      "output_tokens": 16
    },
    {
      "id": "input-short",
      "title": "Short input",
      "group": "Input size",
      "isolates": "Reading about 15 words",
      "input_words": 15,
      "output_tokens": 16
    },
    {
      "id": "input-medium",
      "title": "Medium input",
      "group": "Input size",
      "isolates": "Reading about 400 words",
      "input_words": 400,
      "output_tokens": 16
    },
    {
      "id": "input-long",
      "title": "Long input",
      "group": "Input size",
      "isolates": "Reading about 1,500 words",
      "input_words": 1500,
      "output_tokens": 16
    },
    {
      "id": "output-short",
      "title": "Short output",
      "group": "Output size",
      "isolates": "Writing 16 tokens",
      "input": "tiny",
      "output_tokens": 16,
      "output": "count"
    },
    {
      "id": "output-medium",
      "title": "Medium output",
      "group": "Output size",
      "isolates": "Writing 200 tokens",
      "input": "tiny",
      "output_tokens": 200,
      "output": "count"
    },
    {
      "id": "output-long",
      "title": "Long output",
      "group": "Output size",
      "isolates": "Writing 800 tokens",
      "input": "tiny",
      "output_tokens": 800,
      "output": "count"
    },
    {
      "id": "reuse",
      "title": "Prompt reuse",
      "group": "Prompt reuse",
      "isolates": "Sending the same 400-word input a second time",
      "input_words": 400,
      "output_tokens": 16,
      "reuse": true
    },
    {
      "id": "thinking-on",
      "title": "Thinking on",
      "group": "Thinking",
      "isolates": "A reasoning question with thinking turned on",
      "thinking_only": true,
      "think": true,
      "input": "reasoning",
      "output_tokens": 1500
    },
    {
      "id": "thinking-off",
      "title": "Thinking off",
      "group": "Thinking",
      "isolates": "The same question with thinking turned off",
      "thinking_only": true,
      "think": false,
      "input": "reasoning",
      "output_tokens": 1500
    },
    {
      "id": "context-50",
      "title": "Context 50% full",
      "group": "Context",
      "isolates": "Reading with a 2K window half full",
      "window": 2048,
      "fill": 0.5,
      "output_tokens": 16
    },
    {
      "id": "context-90",
      "title": "Context 90% full",
      "group": "Context",
      "isolates": "Reading with a 2K window nearly full",
      "window": 2048,
      "fill": 0.9,
      "output_tokens": 16
    },
    {
      "id": "context-over",
      "title": "Context overfull",
      "group": "Context",
      "isolates": "Sending 125% of a 2K window; Ollama drops the oldest messages to fit",
      "window": 2048,
      "fill": 1.25,
      "output_tokens": 16
    }
  ],
